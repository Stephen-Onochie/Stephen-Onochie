# --- LG TV Proxy configuration ---
# Copy this file to ".env" and fill in your values:  cp .env.example .env

# IP address of your LG WebOS TV on the local network.
# Find it on the TV: Settings -> Network -> Wi-Fi/Wired Connection -> Advanced.
# Tip: give the TV a DHCP reservation in your router so the IP never changes.
TV_IP=192.168.1.50

# Port the proxy listens on locally. cloudflared will point at this.
PORT=3001

# Shared secret. The web UI must send this as `Authorization: Bearer <token>`.
# Generate one with:  openssl rand -hex 24
# Leave blank to disable auth (NOT recommended once exposed via a tunnel).
API_TOKEN=

# Comma-separated list of browser origins allowed to call this proxy (CORS).
# Use your hosted playground origin, e.g. https://stephen-onochie.vercel.app
# "*" allows any origin (fine for purely-local testing, not with a public tunnel).
ALLOWED_ORIGINS=*
